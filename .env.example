# Copy to .env.local for the web app. Provide the same values to the worker.
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-random-secret
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=replace-with-your-google-oauth-client-secret
GMAIL_TOKEN_ENCRYPTION_KEY=replace-with-base64-encoded-32-random-bytes
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=hirehello

# Optional worker controls. Run one worker process for the MVP.
WORKER_POLL_MS=5000
WORKER_SEND_INTERVAL_MS=15000
WORKER_DAILY_CAP=20
